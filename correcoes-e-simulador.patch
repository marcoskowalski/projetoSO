+        // descartada, para que a tarefa execute de fato as 10 vezes do enunciado.
+        std::deque<int> pendentes;
+
     public:
         explicit TCB(const Tarefa& tarefa);
         ~TCB();
@@ -27,7 +50,24 @@ class TCB
         // Começa uma nova ativação da tarefa no instante indicado.
